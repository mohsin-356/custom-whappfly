# =============================================================
# WhatsBridge - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================

# --- Application ---
PORT=3000
NODE_ENV=production
BASE_URL=http://localhost:3000

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/whatsbridge

# --- Redis (optional - set REDIS_ENABLED=true to enable BullMQ queues) ---
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Authentication ---
# Generate strong random secrets for production!
JWT_SECRET=change-this-to-a-very-long-random-jwt-secret-string
JWT_EXPIRY=24h
API_KEY=change-this-to-a-random-api-key-string
DASHBOARD_PASSWORD=admin123

# --- Session Encryption ---
# Must be exactly 32 characters
SESSION_ENCRYPTION_KEY=change-this-32-char-key-here!!

# --- Webhook ---
WEBHOOK_SECRET=change-this-to-a-random-webhook-secret
WEBHOOK_TIMEOUT=30000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5000

# --- Paths ---
SESSIONS_PATH=./sessions
UPLOADS_PATH=./uploads
LOGS_PATH=./logs

# --- Media ---
MAX_MEDIA_SIZE=50mb
MEDIA_TEMP_TTL=86400

# --- Logging ---
LOG_LEVEL=info
LOG_MAX_FILES=14
LOG_MAX_SIZE=20m

# --- CORS (comma-separated origins, or * for all) ---
CORS_ORIGINS=*

# --- Rate Limiting ---
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
